# Qwen inference
INFERENCE_API_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=Qwen/Qwen3-8B
INFERENCE_CA_CERT=certs/vm05-ca.crt

# BGE embeddings
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CA_CERT=certs/vm02-ca.crt
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_DELAY=2

# Retrieval
CORPUS_PATH=data/corpus_medical_v2_200.jsonl
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_TOP_N=20

# Observability
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
